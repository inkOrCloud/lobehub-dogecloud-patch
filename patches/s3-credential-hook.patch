+// ─── Dynamic credential provider hook ───────────────────────────────
+// Allows third-party platforms to supply temporary STS tokens + S3 config
+// (endpoint, bucket) instead of static env vars.
+//
+// Usage:
+//   import { setCredentialProvider } from '@/server/modules/S3';
+//   setCredentialProvider(() => ({
+//     endpoint: 'https://...',       // optional, overrides constructor param
+//     bucket: 'my-bucket',           // optional, overrides constructor option
+//     credentials: async () => ({
+//       accessKeyId, secretAccessKey, sessionToken, expiration,
+//     }),
+//   }));
+//
+// After registration, all `new S3()` call sites automatically resolve
+// through this provider. Call with `undefined` to reset.
+
+export type S3CredentialIdentityProvider = () => Promise<{
+  accessKeyId: string;
+  secretAccessKey: string;
+  sessionToken?: string;
+  expiration?: Date;
+}>;
+
+export interface S3CredentialProviderResult {
+  credentials: S3CredentialIdentityProvider;
+  /** Override S3 endpoint. Falls back to constructor arg if absent. */
+  endpoint?: string;
+  /** Override S3 bucket. Falls back to constructor option if absent. */
+  bucket?: string;
+}
+
+export type S3CredentialProviderFn = () => S3CredentialProviderResult;
+
+let _credentialProvider: S3CredentialProviderFn | undefined;
+
+export const setCredentialProvider = (provider: S3CredentialProviderFn | undefined): void => {
+  _credentialProvider = provider;
+};
+
+const getCredentialProvider = (): S3CredentialProviderFn | undefined => _credentialProvider;
+
+// ─── End credential provider hook ───────────────────────────────────
+
