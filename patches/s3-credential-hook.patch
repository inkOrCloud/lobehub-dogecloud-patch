From: LobeHub DogeCloud Patch
Date: 2026-07-29
Subject: Add dynamic S3 credential provider hook (with endpoint/bucket override)

Adds a static credential registration mechanism to the S3 class. The
registered provider returns both temporary STS credentials and (optionally)
the S3 endpoint and bucket, allowing platforms like DogeCloud to supply the
full S3 configuration dynamically.

Env vars S3_ENDPOINT / S3_BUCKET still take effect — they serve as the
fallback when the provider does not supply these values.

All existing `new FileS3()` call sites work unchanged.

--- a/apps/server/src/modules/S3/index.ts	2026-07-29 01:07:21.026007813 +0800
+++ b/apps/server/src/modules/S3/index.ts	2026-07-29 01:26:29.839256400 +0800
@@ -26,6 +26,50 @@
 const DEFAULT_S3_REGION = 'us-east-1';
 const PUBLIC_READ_ACL_HEADER = 'public-read';
 
+// ─── Dynamic credential provider hook ───────────────────────────────
+// Allows third-party platforms to supply temporary STS tokens + S3 config
+// (endpoint, bucket) instead of static env vars.
+//
+// Usage:
+//   import { setCredentialProvider } from '@/server/modules/S3';
+//   setCredentialProvider(() => ({
+//     endpoint: 'https://...',       // optional, overrides constructor param
+//     bucket: 'my-bucket',           // optional, overrides constructor option
+//     credentials: async () => ({
+//       accessKeyId, secretAccessKey, sessionToken, expiration,
+//     }),
+//   }));
+//
+// After registration, all `new FileS3()` call sites automatically resolve
+// through this provider. Call with `undefined` to reset.
+
+export type S3CredentialIdentityProvider = () => Promise<{
+  accessKeyId: string;
+  secretAccessKey: string;
+  sessionToken?: string;
+  expiration?: Date;
+}>;
+
+export interface S3CredentialProviderResult {
+  credentials: S3CredentialIdentityProvider;
+  /** Override S3 endpoint. Falls back to constructor param / env var if absent. */
+  endpoint?: string;
+  /** Override S3 bucket. Falls back to constructor option if absent. */
+  bucket?: string;
+}
+
+export type S3CredentialProviderFn = () => S3CredentialProviderResult;
+
+let _credentialProvider: S3CredentialProviderFn | undefined;
+
+export const setCredentialProvider = (provider: S3CredentialProviderFn | undefined): void => {
+  _credentialProvider = provider;
+};
+
+const getCredentialProvider = (): S3CredentialProviderFn | undefined => _credentialProvider;
+
+// ─── End credential provider hook ───────────────────────────────────
+
 export interface PreSignedUpload {
   headers?: Record<string, string>;
   url: string;
